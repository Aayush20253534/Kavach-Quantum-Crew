+import { ApiResponse } from "../../common/responses/ApiResponse.js";
+import { trackingService } from "./tracking.service.js";
+
+export const createTrackingController = ({ service = trackingService } = {}) => ({
+  ping: async (request, response) =>
+    ApiResponse.success(response, {
+      statusCode: 201,
+      message: "Location update accepted",
+      data: await service.submitPing(request.user.id, request.body),
+    }),
+  latest: async (request, response) =>
+    ApiResponse.success(response, {
+      message: "Latest trusted location",
+      data: await service.getLatest(request.user.id, request.query.tripId),
+    }),
+  grantConsent: async (request, response) =>
+    ApiResponse.success(response, {
+      message: "Tracking consent granted",
+      data: await service.grantConsent(request.user.id, request.params.tripId),
+    }),
+  revokeConsent: async (request, response) =>
+    ApiResponse.success(response, {
+      message: "Tracking consent revoked",
+      data: await service.revokeConsent(request.user.id, request.params.tripId),
+    }),
+  groupLocations: async (request, response) =>
+    ApiResponse.success(response, {
+      message: "Group locations",
+      data: await service.getGroupLocations(request.user.id, request.params.groupId),
+    }),
+});
+
+export const trackingController = createTrackingController();
+export default trackingController;
