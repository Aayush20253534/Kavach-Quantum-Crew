generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String        @id @default(uuid()) @db.Uuid
  name                String        @db.VarChar(120)
  username            String        @unique @db.VarChar(40)
  email               String        @unique @db.VarChar(254)
  phone               String        @unique @db.VarChar(20)
  passwordHash        String
  status              AccountStatus @default(ACTIVE)
  onboardingCompleted Boolean       @default(false)
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  profilePicUrl       String?
  gender              Gender?
  age                 Int?
  medicalHistory      String?
  emergencyPhone      String?       @db.VarChar(20)
  nationality         String?       @db.VarChar(80)
  groupMemberships    GroupMember[]
  ledGroups           TripGroup[]   @relation("GroupLeader")
  trips               Trip[]

  @@index([status])
  @@index([nationality])
  @@map("users")
}

model DisasterManager {
  id                String        @id @default(uuid()) @db.Uuid
  name              String        @db.VarChar(120)
  username          String        @unique @db.VarChar(40)
  email             String        @unique @db.VarChar(254)
  phone             String        @unique @db.VarChar(20)
  passwordHash      String
  status            AccountStatus @default(ACTIVE)
  organization      String?       @db.VarChar(160)
  department        String?       @db.VarChar(120)
  jurisdiction      String?       @db.VarChar(160)
  staffInfo         String?
  responderStatus   ResponderStatus @default(AVAILABLE)
  maxActiveIncidents Int          @default(5)
  statusChangedAt   DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@index([responderStatus, status])
  @@index([organization, jurisdiction])
  @@map("disaster_managers")
}

model SystemAdmin {
  id                String        @id @default(uuid()) @db.Uuid
  name              String        @db.VarChar(120)
  username          String        @unique @db.VarChar(40)
  email             String        @unique @db.VarChar(254)
  phone             String        @unique @db.VarChar(20)
  passwordHash      String
  status            AccountStatus @default(ACTIVE)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@map("system_admins")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  accountId        String    @db.Uuid
  accountRole      Role
  refreshTokenHash String    @unique @db.VarChar(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?   @db.VarChar(512)
  ipAddress        String?   @db.VarChar(64)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([accountId, accountRole, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(100)
  entityType String?  @db.VarChar(100)
  entityId   String?  @db.VarChar(100)
  metadata   Json?
  ipAddress  String?  @db.VarChar(64)
  createdAt  DateTime @default(now())
  actorRole  Role?

  @@index([actorId, actorRole, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Trip {
  id             String        @id @default(uuid()) @db.Uuid
  touristId      String        @db.Uuid
  locationName   String        @db.VarChar(160)
  tripType       TripType
  status         TripStatus    @default(PLANNED)
  plannedStartAt DateTime
  plannedEndAt   DateTime
  startedAt      DateTime?
  endedAt        DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  consents       TripConsent[]
  group          TripGroup?
  safetyId       TripSafetyId?
  tourist        User          @relation(fields: [touristId], references: [id], onDelete: Cascade)

  @@index([touristId, status, createdAt])
  @@index([plannedStartAt, plannedEndAt])
  @@map("trips")
}

model TripSafetyId {
  id        String    @id @default(uuid()) @db.Uuid
  tripId    String    @unique @db.Uuid
  publicId  String    @unique @db.VarChar(80)
  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([expiresAt, revokedAt])
  @@map("trip_safety_ids")
}

model TripConsent {
  id        String        @id @default(uuid()) @db.Uuid
  tripId    String        @db.Uuid
  type      ConsentType
  status    ConsentStatus @default(GRANTED)
  grantedAt DateTime      @default(now())
  revokedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  trip      Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, type])
  @@index([tripId, status])
  @@map("trip_consents")
}

model TripGroup {
  id          String            @id @default(uuid()) @db.Uuid
  tripId      String            @unique @db.Uuid
  leaderId    String            @db.Uuid
  status      GroupStatus       @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  closedAt    DateTime?
  invitations GroupInvitation[]
  members     GroupMember[]
  leader      User              @relation("GroupLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  trip        Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([leaderId, status])
  @@map("trip_groups")
}

model GroupMember {
  id        String          @id @default(uuid()) @db.Uuid
  groupId   String          @db.Uuid
  userId    String          @db.Uuid
  role      GroupMemberRole @default(MEMBER)
  joinedAt  DateTime        @default(now())
  leftAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  group     TripGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId, leftAt])
  @@map("group_members")
}

model GroupInvitation {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @db.Uuid
  code      String    @unique @db.VarChar(32)
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  group     TripGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, expiresAt, revokedAt])
  @@map("group_invitations")
}

enum Role {
  TOURIST
  DISASTER_MANAGER
  SYSTEM_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ResponderStatus {
  AVAILABLE
  BUSY
  OFF_DUTY
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum TripType {
  SOLO
  GROUP
}

enum TripStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ConsentType {
  LOCATION_TRACKING
  EMERGENCY_SHARING
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

enum GroupStatus {
  ACTIVE
  CLOSED
}

enum GroupMemberRole {
  LEADER
  MEMBER
}


model TripParticipantConsent {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @db.Uuid
  userId    String   @db.Uuid
  grantedAt DateTime @default(now())
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tripId, userId])
  @@index([userId, revokedAt])
  @@map("trip_participant_consents")
}

model LocationPing {
  id            String              @id @default(uuid()) @db.Uuid
  tripId        String              @db.Uuid
  userId        String              @db.Uuid
  latitude      Float
  longitude     Float
  accuracyM     Float
  altitudeM     Float?
  headingDeg    Float?
  speedMps      Float?
  batteryLevel  Int?
  networkStatus NetworkStatus?
  capturedAt    DateTime
  receivedAt    DateTime            @default(now())
  trustStatus   LocationTrustStatus @default(TRUSTED)
  createdAt     DateTime            @default(now())
  @@unique([tripId, userId, capturedAt])
  @@index([tripId, userId, capturedAt])
  @@map("location_pings")
}

model LatestTrustedLocation {
  id             String   @id @default(uuid()) @db.Uuid
  tripId         String   @db.Uuid
  userId         String   @db.Uuid
  locationPingId String   @db.Uuid
  latitude       Float
  longitude      Float
  accuracyM      Float
  capturedAt     DateTime
  updatedAt      DateTime @updatedAt
  @@unique([tripId, userId])
  @@index([locationPingId])
  @@map("latest_trusted_locations")
}

model SafetyZone {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(120)
  description String?
  type        SafetyZoneType
  severity    SafetySeverity @default(LOW)
  latitude    Float
  longitude   Float
  radiusM     Float
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  @@index([active, type])
  @@map("safety_zones")
}

model TripCheckIn {
  id          String        @id @default(uuid()) @db.Uuid
  tripId      String        @db.Uuid
  userId      String        @db.Uuid
  dueAt       DateTime
  status      CheckInStatus @default(PENDING)
  checkedInAt DateTime?
  missedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@index([tripId, userId, status, dueAt])
  @@index([status, dueAt])
  @@map("trip_check_ins")
}

model GeofenceEvent {
  id         String            @id @default(uuid()) @db.Uuid
  tripId     String            @db.Uuid
  userId     String            @db.Uuid
  zoneId     String            @db.Uuid
  type       GeofenceEventType
  occurredAt DateTime          @default(now())
  createdAt  DateTime          @default(now())
  @@index([tripId, userId, zoneId, occurredAt])
  @@index([zoneId, occurredAt])
  @@map("geofence_events")
}

model SafetyAlert {
  id             String            @id @default(uuid()) @db.Uuid
  tripId         String            @db.Uuid
  userId         String            @db.Uuid
  type           SafetyAlertType
  level          SafetyAlertLevel
  status         SafetyAlertStatus @default(OPEN)
  sourceId       String?           @db.VarChar(100)
  message        String            @db.VarChar(240)
  details        Json?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  @@index([tripId, userId, status, createdAt])
  @@index([type, sourceId, status])
  @@map("safety_alerts")
}

model Incident {
  id                  String             @id @default(uuid()) @db.Uuid
  tripId              String             @db.Uuid
  userId              String             @db.Uuid
  sourceType          IncidentSourceType
  sourceSafetyAlertId String?            @unique @db.Uuid
  severity            IncidentSeverity
  status              IncidentStatus     @default(OPEN)
  title               String             @db.VarChar(160)
  description         String?            @db.VarChar(1000)
  latitude            Float?
  longitude           Float?
  acknowledgedById    String?            @db.Uuid
  acknowledgedByRole  Role?
  acknowledgedAt      DateTime?
  startedAt           DateTime?
  resolvedById        String?            @db.Uuid
  resolvedByRole      Role?
  resolvedAt          DateTime?
  dismissedAt         DateTime?
  resolutionNote      String?            @db.VarChar(1000)
  assignedToId        String?            @db.Uuid
  assignedToRole      Role?
  assignedAt          DateTime?
  escalationLevel     Int                @default(0)
  lastEscalatedAt     DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  @@index([status, severity, createdAt])
  @@index([tripId, userId, status])
  @@map("incidents")
}

model IncidentEvent {
  id         String            @id @default(uuid()) @db.Uuid
  incidentId String            @db.Uuid
  type       IncidentEventType
  actorId    String?           @db.Uuid
  actorRole  Role?
  note       String?           @db.VarChar(1000)
  metadata   Json?
  createdAt  DateTime          @default(now())
  @@index([incidentId, createdAt])
  @@map("incident_events")
}

model SosRequest {
  id            String        @id @default(uuid()) @db.Uuid
  incidentId    String        @unique @db.Uuid
  tripId        String        @db.Uuid
  userId        String        @db.Uuid
  emergencyType EmergencyType
  message       String?       @db.VarChar(500)
  latitude      Float?
  longitude     Float?
  accuracyM     Float?
  triggeredAt   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  @@index([tripId, userId, triggeredAt])
  @@map("sos_requests")
}

enum NetworkStatus {
  WIFI
  CELLULAR
  OFFLINE
  UNKNOWN
}
enum LocationTrustStatus {
  TRUSTED
  REJECTED
}
enum SafetyZoneType {
  SAFE
  RISK
}
enum SafetySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum CheckInStatus {
  PENDING
  COMPLETED
  MISSED
}
enum GeofenceEventType {
  ENTER
  EXIT
}
enum SafetyAlertType {
  RISK_ZONE_ENTRY
  MISSED_CHECK_IN
  STALE_LOCATION
}
enum SafetyAlertLevel {
  WARNING
  DANGER
}
enum SafetyAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}
enum IncidentSourceType {
  SAFETY_ALERT
  SOS
}
enum IncidentSeverity {
  WARNING
  DANGER
  CRITICAL
}
enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  DISMISSED
}
enum IncidentEventType {
  CREATED
  ACKNOWLEDGED
  RESPONSE_STARTED
  RESOLVED
  DISMISSED
  ESCALATED
}
enum EmergencyType {
  MEDICAL
  LOST
  THREAT
  ACCIDENT
  NATURAL_DISASTER
  OTHER
}


model Notification {
  id              String             @id @default(uuid()) @db.Uuid
  targetAccountId String             @db.Uuid
  targetRole      Role
  incidentId      String?            @db.Uuid
  type            NotificationType
  dedupeKey       String             @unique @db.VarChar(220)
  title           String             @db.VarChar(160)
  message         String             @db.VarChar(500)
  readAt          DateTime?
  createdAt       DateTime           @default(now())
  @@index([targetAccountId, targetRole, readAt, createdAt])
  @@index([incidentId, createdAt])
  @@map("notifications")
}

model IncidentAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  incidentId     String   @db.Uuid
  responderId    String   @db.Uuid
  responderRole  Role
  assignedById   String   @db.Uuid
  assignedByRole Role
  assignedAt     DateTime @default(now())
  unassignedAt   DateTime?
  @@index([incidentId, unassignedAt, assignedAt])
  @@index([responderId, responderRole, unassignedAt])
  @@map("incident_assignments")
}

model IncidentNote {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @db.Uuid
  authorId   String   @db.Uuid
  authorRole Role
  note       String   @db.VarChar(1000)
  createdAt  DateTime @default(now())
  @@index([incidentId, createdAt])
  @@map("incident_notes")
}

enum NotificationType {
  INCIDENT_CREATED
  INCIDENT_ACKNOWLEDGED
  INCIDENT_ASSIGNED
  RESPONSE_STARTED
  INCIDENT_RESOLVED
  INCIDENT_DISMISSED
  INCIDENT_ESCALATED
  GROUP_MEMBER_EMERGENCY
}


model HazardReport {
  id             String         @id @default(uuid()) @db.Uuid
  reporterId     String         @db.Uuid
  reporterRole   Role
  type           HazardType
  severity       HazardSeverity @default(MEDIUM)
  status         HazardStatus   @default(PENDING)
  title          String         @db.VarChar(160)
  description    String         @db.VarChar(1000)
  latitude       Float
  longitude      Float
  locationName   String?        @db.VarChar(200)
  occurredAt     DateTime
  reviewedById   String?        @db.Uuid
  reviewedByRole Role?
  moderationNote String?        @db.VarChar(1000)
  verifiedAt     DateTime?
  rejectedAt     DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, severity, createdAt])
  @@index([type, status, createdAt])
  @@index([reporterId, reporterRole, createdAt])
  @@index([latitude, longitude, status])
  @@map("hazard_reports")
}

enum HazardType {
  FLOOD
  LANDSLIDE
  FIRE
  ROAD_BLOCK
  WEATHER
  CROWD
  UNSAFE_AREA
  MEDICAL
  OTHER
}

enum HazardSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum HazardStatus {
  PENDING
  VERIFIED
  REJECTED
  RESOLVED
}
