# Application
NODE_ENV=development
APP_NAME=smart-tourist-safety-backend
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL / Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_tourist_safety?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Browser and Socket.IO access (comma-separated, never use * with credentials)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true
SOCKET_IO_ENABLED=true

# HTTP safety and operations
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
TRUST_PROXY=false
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
