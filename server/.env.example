# Application
NODE_ENV=development
APP_NAME=smart-tourist-safety-backend
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL / Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_tourist_safety?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Browser and Socket.IO access
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true
SOCKET_IO_ENABLED=true

# HTTP safety and operations
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
SENSITIVE_RATE_LIMIT_WINDOW_MS=60000
SENSITIVE_RATE_LIMIT_MAX=30
SECURITY_MAX_OBJECT_DEPTH=20
SECURITY_MAX_OBJECT_KEYS=2000
# Render sits behind a reverse proxy. Use true in Render, false locally.
TRUST_PROXY=false
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# Upstash Redis REST cache (server-side only)
REDIS_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=sts
REDIS_DASHBOARD_TTL_SECONDS=30
REDIS_DESTINATIONS_TTL_SECONDS=900
REDIS_RISK_ZONES_TTL_SECONDS=30

# Phase 1 authentication
ACCESS_TOKEN_SECRET=dev-access-token-secret-change-me
REFRESH_TOKEN_SECRET=dev-refresh-token-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=15
JWT_ISSUER=smart-tourist-safety
JWT_AUDIENCE=smart-tourist-safety-client
REFRESH_COOKIE_NAME=sts_refresh
# For Vercel frontend -> Render backend, use true + none in Render.
# Local HTTP development can keep false + lax.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax

# System Admin seed account
# In development, `npm run prisma:seed` falls back to:
#   username: system.admin
#   email: admin@quantumcrew.local
#   password: QuantumAdmin@123
# Production does NOT use those demo credentials. Set email/password explicitly.
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_USERNAME=system.admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PHONE=9000000001
SEED_ADMIN_PASSWORD=

SEED_DM_USERNAME=disaster.manager
SEED_DM_EMAIL=
SEED_DM_PHONE=+910000000002
SEED_DM_PASSWORD=

# Phase 9 incident escalation
INCIDENT_ACK_TIMEOUT_MINUTES=5
INCIDENT_ESCALATION_INTERVAL_MINUTES=5

# Email verification via Brevo Transactional Email API
BREVO_API_KEY=
BREVO_SENDER_EMAIL=quantumcreww.official@gmail.com
BREVO_SENDER_NAME=QuantumCrew

EMAIL_OTP_SECRET=dev-email-otp-secret-change-me
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5

# Tourist profile images via Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PROFILE_IMAGE_MAX_FILE_BYTES=5242880
MEDICAL_DOCUMENT_MAX_FILE_BYTES=10485760

# Server-side Google Places API (New) key for Disaster Management jurisdiction services
GOOGLE_MAPS_API_KEY=

# Blockchain-backed trip credentials + QR verification
# The Express API talks to the isolated blockchain/ gateway over HTTP.
# On Render, point BLOCKCHAIN_GATEWAY_URL at the separate blockchain Web Service URL.
# Do NOT copy CHAIN_RPC_URL, CONTRACT_ADDRESS or ISSUER_PRIVATE_KEY into this service.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_GATEWAY_URL=http://127.0.0.1:4100
# Production example: https://your-blockchain-gateway.onrender.com
BLOCKCHAIN_GATEWAY_KEY=dev-chain-gateway-key-change-me
BLOCKCHAIN_DATA_ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-32-characters
# Numeric uint8 used by TrustAnchor.issueId; NOT CONTRACT_VERSION=trust-anchor-v1
BLOCKCHAIN_CONTRACT_VERSION=1
BLOCKCHAIN_WORKER_INTERVAL_MS=5000
BLOCKCHAIN_MAX_ATTEMPTS=5

# Public frontend URL used by QR verification and emergency email deep links.
# Emergency emails open /login?redirect=... first. The frontend should redirect an
# already-authenticated account immediately, or authenticate and then honor redirect.
QR_TOKEN_SECRET=dev-qr-token-secret-change-me
PUBLIC_APP_URL=http://localhost:5173
