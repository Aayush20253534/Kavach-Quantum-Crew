# Existing chain/deployment values (keep the values supplied by the blockchain team)
CHAIN_RPC_URL=
CHAIN_ID=11155111
CONTRACT_ADDRESS=
CONTRACT_VERSION=trust-anchor-v1
ISSUER_PRIVATE_KEY=

# Legacy aliases supported for compatibility with the current blockchain team's .env.
# Prefer the uppercase names above for new deployments.
address=
privateKey=

# Internal HTTP gateway consumed by server/.
# Generate a long random value and use the SAME value as BLOCKCHAIN_GATEWAY_KEY in server/.
GATEWAY_API_KEY=replace-with-a-long-random-secret

# Local-only overrides. On Render, PORT is injected automatically and the gateway binds to 0.0.0.0.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4100

# Optional: maximum time for /ready blockchain RPC checks. /health does not contact the chain.
GATEWAY_READINESS_TIMEOUT_MS=5000
