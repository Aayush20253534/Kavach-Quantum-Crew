{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
  },
  "include": [
    "hardhat.config.ts",
    "scripts/**/*.ts",
    "gateway/**/*.ts",
    "test/**/*.ts"
  ]
}