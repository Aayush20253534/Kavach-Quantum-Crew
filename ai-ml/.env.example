NODE_ENV=development
HOST=0.0.0.0
PORT=4200

# Comma-separated browser origins allowed to call this AI service.
CORS_ORIGINS=http://localhost:5173

# Groq inference provider.
GROQ_API_KEY=gsk_replace_me
GROQ_MODEL=llama-3.3-70b-versatile

# Knowledge-base directory. Relative paths are resolved from ai-ml/ at runtime.
KB_DIR=kb

# Conversation memory retained per in-memory conversation id.
CHATBOT_MAX_HISTORY=10
CHATBOT_MAX_MESSAGE_LENGTH=2000

# Recommended for production. When true, the AI service verifies the same
# HS256 access token issued by the main Kavach backend.
AI_REQUIRE_AUTH=true
ACCESS_TOKEN_SECRET=replace-with-the-SAME-access-token-secret-as-main-backend
JWT_ISSUER=smart-tourist-safety-backend
JWT_AUDIENCE=smart-tourist-safety-client

# Basic abuse protection for the separately deployed public HTTP service.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
