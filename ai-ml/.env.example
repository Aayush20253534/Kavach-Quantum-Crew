NODE_ENV=development
HOST=0.0.0.0
PORT=4200

# PostgreSQL used for persistent, per-user chatbot history.
# This may point to the same PostgreSQL database used by the main Kavach backend.
DATABASE_URL=postgresql://user:password@localhost:5432/kavach
DB_POOL_MAX=5

# Comma-separated browser origins allowed to call this AI service.
CORS_ORIGINS=http://localhost:5173

# Groq inference provider.
GROQ_API_KEY=gsk_replace_me
GROQ_MODEL=llama-3.3-70b-versatile

# Knowledge-base directory. Relative paths are resolved from ai-ml/ at runtime.
KB_DIR=kb

# Number of recent persisted messages supplied back to the model as context.
CHATBOT_MAX_HISTORY=10
CHATBOT_MAX_MESSAGE_LENGTH=2000

# Recommended for production. These MUST match the main Kavach backend token config.
AI_REQUIRE_AUTH=true
ACCESS_TOKEN_SECRET=replace-with-the-SAME-access-token-secret-as-main-backend
JWT_ISSUER=smart-tourist-safety
JWT_AUDIENCE=smart-tourist-safety-client

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
